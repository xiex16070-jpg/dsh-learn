{
  "name": "dsh-learn",
  "version": "0.2.2",
  "description": "Persistent learning for DSH: post-turn review turns a session's corrections, failures and fixes into reusable skills; an idle curator keeps the learned library healthy; every lesson keeps its provenance.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.19"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiex16070-jpg/dsh-learn.git"
  },
  "homepage": "https://github.com/xiex16070-jpg/dsh-learn#readme",
  "bugs": {
    "url": "https://github.com/xiex16070-jpg/dsh-learn/issues"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "scripts/selftest.mjs",
    "scripts/replay-session.mjs",
    "scripts/purge-noise.mjs",
    "docs/shots",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/selftest.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "skills",
    "memory",
    "learning",
    "cordis"
  ],
  "license": "MIT"
}
